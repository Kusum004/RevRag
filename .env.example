# RevRag In-App Agent Environment Configuration
# Copy this file to .env and insert your Groq API key

# Groq API Key (Required for Layer 4 Multimodal Vision & Layer 5 Tone-of-Voice Synthesis)
# Get a free key with high throughput at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Target ADB Path (optional override if adb is not in PATH)
# ADB_PATH=C:\Users\YourUser\AppData\Local\Android\Sdk\platform-tools\adb.exe
